<organon version="1">
  <import from="organon-theoria"/>
  <declare-predicate name="Positive">
    <input name="value" type="number"/>
  </declare-predicate>
  <predicate name="Enabled">
    <input name="value" type="number"/>
    <Positive value="{value}"/>
  </predicate>
  <element name="Control">
    <input name="number" type="number"/>
    <let name="label">
      <try type="String" value="{choice}">
        <let name="choice">
          <select type="String">
            <case value="ready">
              <Enabled value="{number}"/>
            </case>
            <case throw="number" value="{number}"/>
          </select>
        </let>
        <catch error="number" capture="error" throw="String" value="negative">
          <not>
            <Positive value="{error}"/>
          </not>
        </catch>
        <catch value="handled"/>
      </try>
    </let>
    <provide name="label" ref="label"/>
  </element>
  <declare-element name="Risk">
    <input name="value" type="number"/>
    <output name="checked" type="String">
      <error type="number"/>
    </output>
  </declare-element>
  <element name="Recover">
    <input name="number" type="number"/>
    <let name="label">
      <try type="String" value="{checked}">
        <bind checked="checked">
          <Risk value="{number}"/>
        </bind>
        <catch error="number" capture="error" value="recovered {error}"/>
      </try>
    </let>
    <provide name="label" ref="label"/>
  </element>
  <element name="Several">
    <input name="number" type="number"/>
    <let name="value">
      <select type="String">
        <case throw="number" value="{number}">
          <Positive value="{number}"/>
        </case>
        <case throw="String" value="negative"/>
      </select>
    </let>
    <provide name="value" ref="value"/>
  </element>
  <element name="NoMatch">
    <let name="value">
      <try type="String" value="{missing}">
        <let name="missing">
          <select type="String">
            <case value="unreachable">
              <any/>
            </case>
          </select>
        </let>
        <catch value="should not catch a contract violation"/>
      </try>
    </let>
    <provide name="value" ref="value"/>
  </element>
  <declare-predicate name="Broken">
    <error type="number"/>
  </declare-predicate>
  <element name="CatchDisplay">
    <let name="label">
      <try type="String" value="{choice}">
        <let name="choice">
          <select type="String">
            <case value="unused">
              <Broken/>
            </case>
          </select>
        </let>
        <catch error="Display" capture="why" value="{message}">
          <bind text="message">
            <ref name="why"/>
          </bind>
        </catch>
      </try>
    </let>
    <provide name="label" ref="label"/>
  </element>
  <element name="ShortCircuit">
    <let name="label">
      <try type="String" value="{choice}">
        <let name="choice">
          <select type="String">
            <case value="first">
              <any>
                <all/>
                <Broken/>
              </any>
            </case>
            <case value="second">
              <Broken/>
            </case>
          </select>
        </let>
        <unreachable/>
      </try>
    </let>
    <provide name="label" ref="label"/>
  </element>
  <export name="CatchDisplay"/>
  <element name="ClassifyError">
    <input name="number" type="number"/>
    <let name="label">
      <try type="String" value="{failed}">
        <let name="failed">
          <select type="String">
            <case throw="number" value="{number}"/>
          </select>
        </let>
        <catch error="number" capture="reason" throw="String" value="positive">
          <Positive value="{reason}"/>
        </catch>
        <catch error="number" capture="reason" throw="number" value="{reason}"/>
      </try>
    </let>
    <provide name="label" ref="label"/>
  </element>
  <export name="ClassifyError"/>
  <element name="CheckAssumption">
    <input name="n" type="number"/>
    <let name="label">
      <try type="String" value="{checked}">
        <let name="checked">
          <try type="String" value="{native}">
            <bind label="native">
              <TwoErrors n="{n}"/>
            </bind>
            <catch error="String" value="recovered"/>
            <unreachable error="Display"/>
            <catch value="too late"/>
          </try>
        </let>
        <catch value="outer recovery"/>
      </try>
    </let>
    <provide name="label" ref="label"/>
  </element>
  <export name="CheckAssumption"/>
  <declare-element name="TwoErrors">
    <input name="n" type="number"/>
    <output name="label" type="String">
      <error type="number"/>
      <error type="String"/>
    </output>
  </declare-element>
  <declare-element name="ThirdNumber" tag="false"/>
  <export name="ThirdNumber"/>
  <declare-predicate name="TwoPredicateErrors">
    <error type="String"/>
    <error type="number"/>
  </declare-predicate>
  <element name="ReadNativeErrors">
    <input name="n" type="number"/>
    <let name="label">
      <try type="String" value="{native}">
        <bind label="native">
          <TwoErrors n="{n}"/>
        </bind>
        <catch error="String" capture="s" value="{s}"/>
        <catch error="number" capture="v" value="number {v}"/>
      </try>
    </let>
    <let name="predicate">
      <try type="String" value="{choice}">
        <let name="choice">
          <select type="String">
            <case value="unreachable">
              <TwoPredicateErrors/>
            </case>
          </select>
        </let>
        <catch value="caught"/>
      </try>
    </let>
    <provide name="label" ref="label"/>
    <provide name="predicate" ref="predicate"/>
  </element>
  <export name="TwoErrors"/>
  <export name="TwoPredicateErrors"/>
  <export name="ReadNativeErrors"/>
  <declare-element name="AcceptErrors">
    <input name="value" type="String">
      <error type="String"/>
      <error type="number"/>
    </input>
    <output name="label" type="String"/>
  </declare-element>
  <element name="ForwardErrors">
    <bind label="source">
      <TwoErrors n="-8"/>
    </bind>
    <bind label="label">
      <AcceptErrors value="{source}"/>
    </bind>
    <provide name="label" ref="label"/>
  </element>
  <export name="AcceptErrors"/>
  <export name="ForwardErrors"/>
  <declare-predicate name="IsReady">
    <input name="text" type="String"/>
  </declare-predicate>
  <predicate name="ReadyOrRecovered">
    <input name="reading" type="String">
      <error type="number"/>
    </input>
    <let name="text">
      <try type="String" value="{candidate}">
        <let name="candidate">
          <select type="String">
            <case value="ready">
              <ReadDirectly reading="{reading}"/>
            </case>
            <case value="pending"/>
          </select>
        </let>
        <catch value="ready"/>
      </try>
    </let>
    <IsReady text="{text}"/>
  </predicate>
  <predicate name="ReadDirectly">
    <input name="reading" type="String">
      <error type="number"/>
    </input>
    <IsReady text="{reading}"/>
  </predicate>
  <element name="PredicateInputs">
    <input name="sample" type="String">
      <error type="number"/>
      <error type="String"/>
    </input>
    <let name="local">
      <select type="String">
        <case value="yes">
          <ReadyOrRecovered reading="{sample}"/>
        </case>
        <case value="no"/>
      </select>
    </let>
    <let name="outer">
      <try type="String" value="{answer}">
        <let name="answer">
          <select type="String">
            <case value="yes">
              <ReadDirectly reading="{sample}"/>
            </case>
            <case value="no"/>
          </select>
        </let>
        <catch value="caller"/>
      </try>
    </let>
    <provide name="local" ref="local"/>
    <provide name="outer" ref="outer"/>
  </element>
  <export name="IsReady"/>
  <export name="PredicateInputs"/>
  <element name="Caption">
    <input name="text" type="String">
      <error type="number"/>
    </input>
    <let name="label">
      <try type="String" value="{text}">
        <catch error="number" value="offline"/>
      </try>
    </let>
    <provide name="label" ref="label"/>
    <provide name="raw" ref="text"/>
  </element>
  <element name="RiskCaption">
    <input name="n" type="number"/>
    <bind checked="value">
      <Risk value="{n}"/>
    </bind>
    <bind label="caption">
      <Caption text="{value}"/>
    </bind>
    <provide name="caption" ref="caption"/>
  </element>
  <export name="Caption"/>
  <element name="InterfaceFailure">
    <input name="text" type="String">
      <error type="Display"/>
    </input>
    <let name="label">
      <try type="String" value="{text}">
        <catch error="number" throw="String" value="must not downcast"/>
        <catch error="Display" value="offline"/>
      </try>
    </let>
    <provide name="label" ref="label"/>
  </element>
  <export name="InterfaceFailure"/>
  <export name="RiskCaption"/>
  <export name="ShortCircuit"/>
  <export name="Broken"/>
  <export name="Several"/>
  <export name="NoMatch"/>
  <export name="Risk"/>
  <export name="Recover"/>
  <export name="Control"/>
  <export name="Positive"/>
</organon>
